{$DOMAIN} {
    handle /api/* {
        reverse_proxy server:{$PORT}
    }

    # Бандлы с хэшем в имени: кэшируются навсегда. Отсутствующий файл — честный 404,
    # а не index.html: иначе устаревшая ссылка на бандл прошлой сборки получает HTML
    # вместо JS, приложение не стартует и в MAX остаётся чёрный экран.
    handle /assets/* {
        root * /srv/goswipe
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # index.html не кэшируем: после пересборки вебвью должен получить новые ссылки на бандлы.
    handle {
        root * /srv/goswipe
        header Cache-Control "no-store"
        try_files {path} /index.html
        file_server
    }
}
