# Скопируй в .env.local (он в .gitignore) и заполни.

# Базовый адрес API, без слэша на конце.
# Обычно задавать не нужно: в dev /api из .env.development идёт через прокси Vite
# (vite.config.js), в продакшене /api из .env.production проксирует Caddy (Caddyfile).
# Полный адрес нужен, только если фронт хостится без такого прокси/rewrite.
VITE_API_URL=https://93-77-180-125.sslip.io/api

# initData для отладки в обычном браузере вне MAX. Работает только в `npm run dev`,
# в продакшен-сборку не попадает. Строку можно взять из window.WebApp.initData внутри MAX.
VITE_DEV_INIT_DATA=
