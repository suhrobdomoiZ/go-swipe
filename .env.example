# Скопируйте в .env и заполните.
# Читается docker-compose.yaml (все переменные ниже обязательны) и серверными ключами
# в server/config/keys.go.

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
# Имя сервиса БД в docker-compose.yaml
POSTGRES_HOST=db
POSTGRES_PORT=5432
# disable | require | verify-full ...
POSTGRES_SSL_MODE=disable

# --- Сервер ---
# Внутренний порт бэкенда; наружу не публикуется, до него ходит только Caddy.
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# Ключ подписи JWT. Обязательно задать свой длинный случайный: при пустом значении
# сервер молча берёт публичный дефолт "secret-key".
SECRET_KEY=
# Срок жизни токена, формат time.ParseDuration (например 24h, 720h)
JWT_TTL=24h
# Разрешённые Origin для CORS через запятую. Через Caddy фронт и API на одном origin,
# поэтому в проде это скорее запасной вариант; для локальной разработки: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- MAX ---
# Токен бота из MAX для проверки initData и отправки напоминаний
MAX_BOT_TOKEN=

# --- Caddy (фронт + прокси на бэк) ---
# Домен, на котором Caddy получает TLS-сертификат, например 203-0-113-10.sslip.io
# или localhost для локального запуска
DOMAIN=
